# Copy this file to .env and fill in real values. Never commit .env.
# Atlas: Cluster -> Connect -> Drivers -> Python (mongodb+srv://...)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=account-brief
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Simple passcode to protect the demo app
APP_PASSCODE=choose-a-passcode
